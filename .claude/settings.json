{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh * pr merge)",
      "Bash(gh * pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh * pr review)",
      "Bash(gh * pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh * pr comment)",
      "Bash(gh * pr comment *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git * push * --force*)",
      "Bash(git * push * -f*)",
      "Bash(git * push * +*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git * commit --amend*)",
      "Bash(git * commit * --amend*)",
      "Bash(git rebase *)",
      "Bash(git * rebase)",
      "Bash(git * rebase *)",
      "Bash(git pull --rebase*)",
      "Bash(git pull * --rebase*)",
      "Bash(git * pull --rebase*)",
      "Bash(git * pull * --rebase*)",
      "Bash(git pull -r*)",
      "Bash(git pull * -r*)",
      "Bash(git * pull -r*)",
      "Bash(git * pull * -r*)",
      "Bash(git tag *)",
      "Bash(git * tag)",
      "Bash(git * tag *)",
      "Bash(*xgp --post*)",
      "Bash(*xgp * --post*)",
      "Bash(*daily_post.py --post*)",
      "Bash(*daily_post.py * --post*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Edit(/tests/acceptance/**)",
      "Edit(/.claude/settings.json)",
      "Read(~/.ai_post_env)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(gh pr *)",
      "Bash(gh * pr)",
      "Bash(gh * pr *)",
      "Bash(gh api *)",
      "Bash(gh * api)",
      "Bash(gh * api *)",
      "Bash(python3 *)",
      "Bash(*.ai_post_env*)"
    ]
  }
}
